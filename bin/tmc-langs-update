#!/bin/bash
# Points services/tmc at a released tmc-langs: downloads the tagged bindings and the matching CLI
# binary, and rewrites the `// VERSION=` line of cli.d.ts that bin/.common's
# ensure_tmc_langs_cli_downloaded, bin/tmc-langs-setup and the system-test workflow all read to pick
# which released binary to fetch.
#
# bin/tmc-langs-update-bindings-from-checkout is the unreleased counterpart: it regenerates the type
# surface from a sibling tmc-langs-rust checkout and leaves that version line alone.
set -euo pipefail
source "$(dirname "$0")/.common"

BASEDIR="$(dirname "${BASH_SOURCE[0]}")"
ROOT_ABSOLUTE_PATH=$(realpath "$BASEDIR/..")
TMC_PATH="$ROOT_ABSOLUTE_PATH/services/tmc"

if [ -z ${1+x} ]; then
  echo -e "Missing version argument"
  exit 1
fi
VERSION="$1"

echo "Updating TMC langs version to $VERSION"

BINDINGS_DOWNLOAD_URL="https://raw.githubusercontent.com/rage/tmc-langs-rust/${VERSION}/crates/tmc-langs-cli/bindings.d.ts"
BINDINGS_DOWNLOAD_TARGET="$TMC_PATH/src/tmc/cli.d.ts"
BINDINGS_GUARD="$TMC_PATH/src/tmc/cli.guard.ts"

echo "Downloading generated type definitions"
# Fetch before removing: a failed download used to leave the checkout with no bindings at all.
GENERATED=$(curl --fail --location --show-error "$BINDINGS_DOWNLOAD_URL")

echo "Removing old generated type definitions"
run_command rm -f "$BINDINGS_DOWNLOAD_TARGET"
run_command rm -f "$BINDINGS_GUARD"
# write version to the file
printf "// VERSION=%s\n" "$VERSION" > "$BINDINGS_DOWNLOAD_TARGET"
# write URL to the file to make it easy to keep track of the version
printf "// %s\n\n" "$BINDINGS_DOWNLOAD_URL" >> "$BINDINGS_DOWNLOAD_TARGET"
echo "$GENERATED" >> "$BINDINGS_DOWNLOAD_TARGET"

regenerate_tmc_langs_bindings_guard "$ROOT_ABSOLUTE_PATH" "$BINDINGS_DOWNLOAD_TARGET" "$BINDINGS_GUARD"

# Delegate the binary: tmc-langs-setup reads the `// VERSION=` line just written, resolves the
# platform triple, and verifies the published sha256 — none of which this script did.
run_command "$BASEDIR/tmc-langs-setup"
