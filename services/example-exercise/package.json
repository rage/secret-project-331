{
  "name": "example-exercise",
  "version": "1.0.1",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "download",
      "version": "24.18.0"
    }
  },
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild dev --port 3002",
    "start": "node server.mjs",
    "test": "vitest run",
    "test:playwright": "playwright test",
    "test:playwright:diagnostics": "playwright test --project=plugin-contract-chromium --debug",
    "test:playwright:focused": "playwright test --project=plugin-contract-chromium",
    "test:playwright:iframe-boundary": "playwright test --project=iframe-boundary-chromium --project=iframe-boundary-firefox --project=iframe-boundary-webkit",
    "test:playwright:plugin-contract": "playwright test --project=plugin-contract-chromium",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run test:playwright"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@react-aria/overlays": "^3.32.1",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "i18next": "^26.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rsbuild/core": "^2.1.13",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-svgr": "^2.0.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "postcss-styled-syntax": "^0.7.2",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11"
  }
}
