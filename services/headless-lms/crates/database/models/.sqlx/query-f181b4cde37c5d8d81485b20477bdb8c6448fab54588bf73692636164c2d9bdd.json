  "query": "\nUPDATE generated_certificates\nSET created_at = $2,\n  name_on_certificate = COALESCE($3, name_on_certificate),\n  updated_at = NOW()\nWHERE id = $1\n  AND deleted_at IS NULL\n  AND (\n    $4::timestamptz IS NULL\n    OR updated_at = $4\n  )\nRETURNING *\n        ",
