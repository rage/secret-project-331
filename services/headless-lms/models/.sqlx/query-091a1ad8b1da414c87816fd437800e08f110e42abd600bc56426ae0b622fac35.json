  "query": "\nSELECT *\nFROM chatbot_conversations\nWHERE (\n    (\n      $1::uuid IS NOT NULL\n      AND user_id = $1\n    )\n    OR (\n      $1::uuid IS NULL\n      AND anonymous_token = $2\n    )\n  )\n  AND chatbot_configuration_id = $3\n  AND deleted_at IS NULL\nORDER BY created_at DESC\nLIMIT 1\n        ",
