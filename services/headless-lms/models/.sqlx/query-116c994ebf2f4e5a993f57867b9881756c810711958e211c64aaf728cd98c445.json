  "query": "\nSELECT m.mailed_at AS \"mailed_at!\"\nFROM password_reset_tokens t,\n  unnest(t.mailed_at) AS m(mailed_at)\nWHERE t.user_id = $1\n  AND t.expires_at > $2\n  AND m.mailed_at > $2\n        ",
