{
  "db_name": "PostgreSQL",
  "query": "\nSELECT ch.id AS chapter_id,\n  ch.name,\n  ch.chapter_number\nFROM chapters ch\nWHERE ch.course_id = $1\n  AND ch.deleted_at IS NULL\n  AND NOT EXISTS (\n    SELECT 1\n    FROM exercises e\n    WHERE e.chapter_id = ch.id\n      AND e.deleted_at IS NULL\n  )\nORDER BY ch.chapter_number\n",
