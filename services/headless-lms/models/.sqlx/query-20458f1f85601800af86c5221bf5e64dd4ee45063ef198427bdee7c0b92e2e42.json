{
  "db_name": "PostgreSQL",
  "query": "\nSELECT p.id,\n  p.order_number,\n  COALESCE(ch.front_page_id = p.id, FALSE) AS \"is_chapter_front_page!\"\nFROM pages p\n  LEFT JOIN chapters ch ON ch.id = p.chapter_id\nWHERE p.course_id = $1\n  AND p.chapter_id IS NOT DISTINCT FROM $2\n  AND p.deleted_at IS NULL\nORDER BY p.order_number,\n  p.id\nFOR UPDATE OF p\n        ",
