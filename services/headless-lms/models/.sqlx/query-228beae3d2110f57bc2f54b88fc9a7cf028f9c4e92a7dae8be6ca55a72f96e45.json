  "query": "\nSELECT user_id,\n  created_at,\n  updated_at,\n  email,\n  first_name,\n  last_name,\n  country,\n  email_communication_consent,\n  email_verified_at,\n  email_verified_method\nFROM user_details\nWHERE $1 <% (name_search_helper || ' ' || split_part(email_search_helper, '@', 1))\nORDER BY $1 <<-> (name_search_helper || ' ' || split_part(email_search_helper, '@', 1)),\n  user_id\nLIMIT $2\n",
