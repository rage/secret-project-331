{
  "db_name": "PostgreSQL",
  "query": "\nSELECT c.id,\n  c.created_at,\n  c.changeset_id,\n  c.user_id,\n  c.oauth_client_id,\n  c.oauth_grant_id,\n  c.client_name,\n  c.tool_name,\n  c.ops,\n  c.summary,\n  c.entity_changes,\n  c.revert_of_call_id\nFROM agent_changeset_calls c\n  JOIN agent_changesets cs ON cs.id = c.changeset_id\nWHERE c.user_id = $1\n  AND cs.course_id = $2\n  AND cs.deleted_at IS NULL\nORDER BY c.created_at DESC,\n  c.id\nLIMIT $3\n        ",
