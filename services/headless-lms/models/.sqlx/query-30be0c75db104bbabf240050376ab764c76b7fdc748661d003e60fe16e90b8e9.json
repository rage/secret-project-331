{
  "db_name": "PostgreSQL",
  "query": "\nSELECT e.id,\n  e.name,\n  e.starts_at,\n  e.ends_at,\n  e.time_minutes,\n  e.minimum_points_treshold,\n  e.grade_manually\nFROM exams e\n  JOIN course_exams ce ON ce.exam_id = e.id\nWHERE ce.course_id = $1\n  AND ce.deleted_at IS NULL\n  AND e.deleted_at IS NULL\nORDER BY e.starts_at NULLS FIRST,\n  e.name\n        ",
