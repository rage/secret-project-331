{
  "db_name": "PostgreSQL",
  "query": "\nSELECT c.id,\n  c.created_at,\n  c.changeset_id,\n  cs.status AS \"changeset_status: AgentChangesetStatus\",\n  cs.expires_at AS changeset_expires_at,\n  c.client_name,\n  c.tool_name,\n  c.summary,\n  c.revert_of_call_id\nFROM agent_changeset_calls c\n  JOIN agent_changesets cs ON cs.id = c.changeset_id\nWHERE cs.user_id = $1\n  AND cs.course_id = $2\n  AND (\n    $3::uuid IS NULL\n    OR EXISTS (\n      SELECT 1\n      FROM agent_changeset_call_entities ce\n      WHERE ce.call_id = c.id\n        AND ce.entity_id = $3\n    )\n  )\nORDER BY c.created_at DESC,\n  c.id\nLIMIT $4\n        ",
