{
  "db_name": "PostgreSQL",
  "query": "\nWITH name_matches AS (\n  SELECT user_id,\n    $1 <<-> name_search_helper AS distance\n  FROM user_details\n  ORDER BY distance\n  LIMIT $2\n),\nemail_matches AS (\n  SELECT user_id,\n    $1 <<-> split_part(email_search_helper, '@', 1) AS distance\n  FROM user_details\n  ORDER BY distance\n  LIMIT $2\n),\nmatches AS (\n  SELECT user_id,\n    min(distance) AS distance\n  FROM (\n      SELECT *\n      FROM name_matches\n      UNION ALL\n      SELECT *\n      FROM email_matches\n    ) candidates\n  WHERE distance < $3\n  GROUP BY user_id\n)\nSELECT ud.user_id,\n  ud.created_at,\n  ud.updated_at,\n  ud.email,\n  ud.first_name,\n  ud.last_name,\n  ud.country,\n  ud.email_communication_consent,\n  ud.email_verified_at,\n  ud.email_verified_method\nFROM matches\n  JOIN user_details ud ON ud.user_id = matches.user_id\nORDER BY matches.distance,\n  ud.user_id\nLIMIT $2\n",
