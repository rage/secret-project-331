  "query": "\nSELECT cr.id,\n  UPPER(TRIM(s.uh_course_code)) AS \"course_code!\"\nFROM credit_registrations cr\n  JOIN credit_registration_subjects s ON s.subject_id = cr.subject_id\nWHERE cr.id = ANY($1)\n  AND NULLIF(TRIM(s.uh_course_code), '') IS NOT NULL\n        ",
