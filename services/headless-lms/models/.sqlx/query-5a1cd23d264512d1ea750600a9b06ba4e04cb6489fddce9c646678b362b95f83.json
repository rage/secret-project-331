  "query": "\nSELECT e.id AS exercise_id,\n  e.page_id\nFROM exercises e\nWHERE e.course_id = $1\n  AND e.deleted_at IS NULL\n  AND EXISTS (\n    SELECT 1\n    FROM exercise_slide_submissions ess\n    WHERE ess.exercise_id = e.id\n      AND ess.deleted_at IS NULL\n  )\n        ",
