  "db_name": "PostgreSQL",
  "query": "\nSELECT p.id,\n  c.id AS course_id,\n  c.course_language_group_id,\n  p.page_language_group_id AS \"group_id!\",\n  (\n    p.deleted_at IS NOT NULL\n    OR c.deleted_at IS NOT NULL\n  ) AS \"is_deleted!\"\nFROM pages p\n  JOIN courses c ON c.id = p.course_id\nWHERE p.id = ANY($1)\nORDER BY p.id\nFOR UPDATE OF p\n            ",
