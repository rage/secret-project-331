  "query": "\nSELECT cs.*\nFROM agent_changesets cs\n  JOIN agent_changeset_entities e ON e.changeset_id = cs.id\nWHERE cs.user_id = $1\n  AND agent_changeset_is_open(cs.status, cs.expires_at)\n  AND e.entity_type = 'page'\n  AND e.entity_id = $2\n        ",
