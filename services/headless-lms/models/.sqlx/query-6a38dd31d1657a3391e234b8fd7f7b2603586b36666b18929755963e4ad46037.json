{
  "db_name": "PostgreSQL",
  "query": "\nSELECT id,\n  created_at,\n  updated_at,\n  deleted_at,\n  endpoint AS \"endpoint!: SuotarEndpoint\",\n  request_item_count,\n  http_status,\n  duration_ms,\n  succeeded,\n  ok_item_count,\n  error_item_count,\n  request_level_error_code,\n  error_message,\n  request_body_sample,\n  response_body_sample,\n  credit_registration_ids,\n  worker_name,\n  started_at,\n  COUNT(*) OVER () AS \"total_count!\"\nFROM suotar_api_calls\nWHERE deleted_at IS NULL\n  AND (\n    $1::suotar_endpoint IS NULL\n    OR endpoint = $1\n  )\n  AND ($2::bool IS NULL OR succeeded = $2)\n  AND ($3::text IS NULL OR worker_name = $3)\n  AND ($4::timestamptz IS NULL OR started_at >= $4)\n  AND ($5::timestamptz IS NULL OR started_at <= $5)\n  AND (\n    $6::uuid IS NULL\n    OR credit_registration_ids @> ARRAY [$6::uuid]\n  )\nORDER BY started_at DESC,\n  id\nLIMIT $7 OFFSET $8\n        ",
