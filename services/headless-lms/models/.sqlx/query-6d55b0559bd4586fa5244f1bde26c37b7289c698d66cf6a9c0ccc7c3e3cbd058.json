  "query": "\nSELECT sisu_person_id AS \"sisu_person_id!\",\n  sent_at,\n  email_delivery_id\nFROM credit_registration_account_linking_emails\nWHERE sisu_person_id = ANY($1::text [])\n  AND (\n    course_id = $2\n    OR external_credit_target_id = $2\n  )\n  AND deleted_at IS NULL\nORDER BY sent_at DESC\n        ",
