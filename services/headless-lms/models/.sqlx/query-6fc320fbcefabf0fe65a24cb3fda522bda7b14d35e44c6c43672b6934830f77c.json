{
  "db_name": "PostgreSQL",
  "query": "\nSELECT id AS \"id!\",\n  created_at AS \"created_at!\",\n  updated_at AS \"updated_at!\",\n  user_id AS \"user_id!\",\n  course_id AS \"course_id!\",\n  status AS \"status!\",\n  expires_at AS \"expires_at!\",\n  published_at,\n  revision AS \"revision!\"\nFROM (\n    (\n      SELECT *\n      FROM agent_changesets\n      WHERE user_id = $1\n        AND course_id = ANY($2)\n        AND status = 'open'\n        AND expires_at > now()\n    )\n    UNION ALL\n    (\n      SELECT *\n      FROM agent_changesets\n      WHERE user_id = $1\n        AND course_id = ANY($2)\n        AND (\n          status <> 'open'\n          OR expires_at <= now()\n        )\n      ORDER BY created_at DESC,\n        id\n      LIMIT $3\n    )\n  ) listed\nORDER BY created_at DESC,\n  id\n        ",
