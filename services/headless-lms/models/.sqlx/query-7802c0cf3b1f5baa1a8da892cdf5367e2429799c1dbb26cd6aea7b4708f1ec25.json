  "query": "\nUPDATE external_courses\nSET name = $1,\n    description = $2,\n    url = $3,\n    name_embedding = COALESCE($4, name_embedding),\n    description_embedding = COALESCE($5, description_embedding),\n    on_old_platform = $6\nWHERE id = $7 AND deleted_at IS NULL\nRETURNING\n        id,\n        name,\n        description,\n        url,\n        on_old_platform\n        ",
