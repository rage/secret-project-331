  "query": "\nSELECT e.id,\n  (\n    e.deleted_at IS NOT NULL\n    OR c.deleted_at IS NOT NULL\n  ) AS \"is_deleted!\"\nFROM exercises e\n  JOIN courses c ON c.id = e.course_id\nWHERE e.exercise_language_group_id = $1\n            ",
