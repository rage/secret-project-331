  "query": "\nSELECT p.id AS plan_id,\n  c.id,\n  c.name,\n  c.slug,\n  c.is_draft\nFROM course_designer_plans p\nJOIN courses c ON c.id = p.created_course_id\n  AND c.deleted_at IS NULL\nWHERE p.id = ANY($1)\n  AND p.deleted_at IS NULL\n",
