  "query": "\nSELECT DISTINCT ON (ce.entity_type, ce.entity_id) ce.entity_type,\n  ce.entity_id,\n  ce.call_id\nFROM agent_changeset_call_entities ce\n  JOIN agent_changeset_calls c ON c.id = ce.call_id\nWHERE c.changeset_id = $1\nORDER BY ce.entity_type,\n  ce.entity_id,\n  c.created_at DESC,\n  c.id DESC\n        ",
