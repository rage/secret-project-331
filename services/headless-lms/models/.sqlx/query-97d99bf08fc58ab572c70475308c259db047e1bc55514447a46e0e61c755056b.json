  "db_name": "PostgreSQL",
  "query": "\nSELECT e.id,\n  c.id AS course_id,\n  c.course_language_group_id,\n  e.exercise_language_group_id AS \"group_id!\",\n  (\n    e.deleted_at IS NOT NULL\n    OR c.deleted_at IS NOT NULL\n  ) AS \"is_deleted!\"\nFROM exercises e\n  JOIN courses c ON c.id = e.course_id\nWHERE e.id = ANY($1)\nORDER BY e.id\nFOR UPDATE OF e\n            ",
