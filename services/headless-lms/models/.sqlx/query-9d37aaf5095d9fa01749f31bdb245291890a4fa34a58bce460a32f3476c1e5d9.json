{
  "db_name": "PostgreSQL",
  "query": "\nUPDATE email_ownership_verification_tokens t\nSET used_at = now()\nWHERE t.token = $1\n  AND t.used_at IS NULL\n  AND t.deleted_at IS NULL\n  AND t.expires_at > now()\n  AND EXISTS (\n    SELECT 1\n    FROM user_details ud\n    WHERE ud.user_id = t.user_id\n      AND lower(ud.email) = lower(t.email)\n  )\nRETURNING t.*\n        ",
