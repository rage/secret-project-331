  "query": "\nSELECT pages.id,\n  pages.title,\n  chapters.name AS chapter_name,\n  pages.course_id,\n  pages.hidden,\n  pages.deleted_at\nFROM pages\nLEFT JOIN chapters ON chapters.id = pages.chapter_id AND chapters.deleted_at IS NULL\nWHERE pages.id = $1;\n",
