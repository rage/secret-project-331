{
  "db_name": "PostgreSQL",
  "query": "\nSELECT p.id,\n  p.title,\n  p.url_path,\n  p.chapter_id,\n  p.content\nFROM pages p\nLEFT JOIN chapters ch ON ch.id = p.chapter_id\nWHERE p.course_id = $1\n  AND p.deleted_at IS NULL\n  AND NOT p.hidden\nORDER BY ch.chapter_number NULLS FIRST,\n  p.order_number,\n  p.id\n",
