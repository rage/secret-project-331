{
  "db_name": "PostgreSQL",
  "query": "\nSELECT TRIM(reason) AS \"reason!\",\n  COUNT(*) AS \"use_count!\",\n  MAX(created_at) AS \"last_used_at!\"\nFROM credit_registration_admin_actions\nWHERE action = $1\n  AND TRIM(reason) <> ''\n  AND deleted_at IS NULL\nGROUP BY TRIM(reason)\nORDER BY MAX(created_at) DESC\nLIMIT $2\n        ",
