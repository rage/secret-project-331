  "db_name": "PostgreSQL",
  "query": "\nSELECT ec.*\nFROM external_completions ec\n  JOIN external_credit_targets t ON t.id = ec.external_credit_target_id\nWHERE ec.user_id = $1\n  AND t.moocfi_course_id = $2\n  AND ec.deleted_at IS NULL\nORDER BY ec.completion_date DESC,\n  ec.created_at DESC\n        ",
