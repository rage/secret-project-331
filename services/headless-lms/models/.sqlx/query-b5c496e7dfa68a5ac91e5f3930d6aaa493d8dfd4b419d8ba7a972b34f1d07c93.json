{
  "db_name": "PostgreSQL",
  "query": "\nSELECT ch.course_id AS \"course_id!\",\n  ch.id AS chapter_id,\n  ch.name,\n  ch.chapter_number,\n  EXISTS (\n    SELECT 1\n    FROM exercises e\n    WHERE e.chapter_id = ch.id\n      AND e.deleted_at IS NULL\n  ) AS \"has_exercises!\"\nFROM chapters ch\nWHERE ch.course_id = ANY($1)\n  AND ch.deleted_at IS NULL\nORDER BY ch.chapter_number\n",
