  "query": "\nSELECT cs.*\nFROM agent_changesets cs\n  JOIN agent_changeset_entities e ON e.changeset_id = cs.id\nWHERE cs.user_id = $1\n  AND cs.status = 'open'\n  AND cs.expires_at > now()\n  AND e.entity_type = 'page'\n  AND e.entity_id = $2\n        ",
