  "query": "\nSELECT re.id,\n  er.id AS repository_id,\n  re.part,\n  re.name,\n  er.url AS repository_url,\n  re.checksum,\n  re.download_url,\n  re.details\nFROM exercise_tasks et\n  JOIN repository_exercises re ON re.id = et.repository_exercise_id\n  JOIN exercise_repositories er ON er.id = re.repository_id\nWHERE et.id = $1\n",
