{
  "db_name": "PostgreSQL",
  "query": "\nINSERT INTO credit_registration_daily_snapshots (\n    snapshot_date,\n    state,\n    count,\n    entered_count,\n    left_count\n  )\nVALUES ($1, $2, $3, $4, $5) ON CONFLICT (snapshot_date, state, deleted_at) DO\nUPDATE\nSET count = $3,\n  entered_count = $4,\n  left_count = $5\n            ",
  "describe": {
    "columns": [],
    "parameters": {
      "Left": [
        "Date",
        {
          "Custom": {
            "name": "credit_registration_state",
            "kind": {
              "Enum": [
                "pending",
                "ready_to_submit",
                "resolving_enrolment",
                "checking_enrolment",
                "no_usable_enrolment",
                "submitting",
                "submission_uncertain",
                "awaiting_verification",
                "registered",
                "duplicate",
                "not_improved",
                "misregistered",
                "failed_retryable",
                "failed_permanent",
                "blocked",
                "cancelled"
              ]
            }
          }
        },
        "Int4",
        "Int4",
        "Int4"
      ]
    },
    "nullable": []
  },
