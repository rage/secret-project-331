  "query": "\nSELECT d.user_id,\n  d.created_at,\n  d.updated_at,\n  d.email,\n  d.first_name,\n  d.last_name,\n  d.country,\n  d.email_communication_consent,\n  d.email_verified_at,\n  d.email_verified_method\nFROM course_instance_enrollments e\n  JOIN user_details d ON e.user_id = d.user_id\nWHERE e.course_id = $1\n  AND e.deleted_at IS NULL\n        ",
