  "query": "\n\nINSERT INTO course_page_markdown_content (markdown_content, page_history_id)\nSELECT data.content, data.page_history_id\nFROM (\n    SELECT unnest($1::text []) AS content,\n      unnest($2::uuid []) AS page_history_id\n  ) AS data\nRETURNING *\n    ",
