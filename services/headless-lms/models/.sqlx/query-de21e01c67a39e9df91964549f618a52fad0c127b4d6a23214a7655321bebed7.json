  "query": "\nSELECT fc.*\nFROM feedback_categories AS fc\nWHERE EXISTS (\n    SELECT id\n    FROM feedback AS f\n    WHERE fc.id = f.category_id\n      AND f.deleted_at IS NULL\n      AND f.course_id = $1\n      AND f.marked_as_read = $2\n  )\n  AND fc.deleted_at IS NULL\n        ",
