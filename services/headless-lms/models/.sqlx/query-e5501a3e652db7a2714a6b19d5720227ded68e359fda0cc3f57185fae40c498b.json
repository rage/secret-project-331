  "query": "\nSELECT id,\n  user_id,\n  code,\n  purpose AS \"purpose: UserEmailCodePurpose\",\n  attempt_count,\n  expires_at,\n  used_at,\n  created_at,\n  updated_at,\n  deleted_at\nFROM user_email_codes\nWHERE user_id = $1\n  AND purpose = $2\n  AND deleted_at IS NULL\n  AND used_at IS NULL\n  AND expires_at > $3\n        ",
