  "query": "\nSELECT cc.id,\n  cc.chatbot_name,\n  c.id AS course_id,\n  c.name AS course_name,\n  cc.course_designer_assistant\nFROM chatbot_configurations cc\n  JOIN courses c ON c.id = cc.course_id\nWHERE cc.deleted_at IS NULL\n  AND c.deleted_at IS NULL\nORDER BY c.name,\n  cc.chatbot_name\n",
