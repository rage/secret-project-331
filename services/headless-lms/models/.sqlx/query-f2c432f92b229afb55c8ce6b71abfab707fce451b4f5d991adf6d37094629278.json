  "query": "\nINSERT INTO course_audiences (\n    course_id,\n    audience,\n    embedding\n  )\nSELECT $1,\n       t.audience,\n       t.embedding\nFROM UNNEST(\n    $2::text[],\n    $3::vector[]\n) AS t(audience, embedding)\nRETURNING\n        id,\n        created_at,\n        updated_at,\n        deleted_at,\n        course_id,\n        audience,\n        embedding as \"embedding: Vector\"\n    ",
