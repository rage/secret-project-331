{
  "db_name": "PostgreSQL",
  "query": "\nSELECT ch.id,\n  ch.course_id,\n  ch.chapter_number,\n  ch.name,\n  (\n    SELECT COUNT(*)\n    FROM pages p\n    WHERE p.chapter_id = ch.id\n      AND p.deleted_at IS NULL\n  ) AS \"page_count!\"\nFROM chapters ch\nWHERE ch.course_id = ANY($1)\n  AND ch.deleted_at IS NULL\nORDER BY ch.course_id,\n  ch.chapter_number\n        ",
