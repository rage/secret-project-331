{
  "db_name": "PostgreSQL",
  "query": "\nSELECT id,\n  created_at,\n  action,\n  outcome,\n  matched_rule_ids,\n  signals,\n  user_id,\n  recipient_domain,\n  network_prefix::text AS network_prefix,\n  address_digest,\n  mailbox_digest\nFROM account_form_decisions\nWHERE (\n    $1::timestamptz IS NULL\n    OR (created_at, id) < ($1, $2::uuid)\n  )\nORDER BY created_at DESC,\n  id DESC\nLIMIT $3\n",
