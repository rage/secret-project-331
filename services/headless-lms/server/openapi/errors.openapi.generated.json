{
  "openapi": "3.1.0",
  "info": {
    "title": "Errors API",
    "description": "",
    "contact": {
      "name": "University of Helsinki",
      "email": "mooc@cs.helsinki.fi"
    },
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v0/errors": {
      "post": {
        "tags": ["errors"],
        "summary": "POST `/api/v0/errors` - Reports an error occurrence.\n\nAccessible to both authenticated and anonymous users. If the user is logged in, their id is stored with the error occurrence.",
        "operationId": "postError",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewErrorReport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Error recorded successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorSource": {
        "type": "string",
        "enum": ["backend", "frontend"]
      },
      "MessageKey": {
        "oneOf": [
          {
            "type": "string",
            "enum": ["internal_error"]
          },
          {
            "type": "string",
            "enum": ["validation_error"]
          },
          {
            "type": "string",
            "enum": ["obsolete_client"]
          },
          {
            "type": "string",
            "enum": ["not_found"]
          },
          {
            "type": "string",
            "enum": ["rate_limited"]
          },
          {
            "type": "string",
            "enum": ["unauthorized"]
          },
          {
            "type": "string",
            "enum": ["forbidden"]
          },
          {
            "type": "string",
            "enum": ["oauth_error"]
          },
          {
            "type": "string",
            "enum": ["sisu_error"]
          },
          {
            "type": "string",
            "enum": ["course_slug_already_taken"]
          },
          {
            "type": "object",
            "required": ["foreign_key_violation"],
            "properties": {
              "foreign_key_violation": {
                "type": "object",
                "properties": {
                  "constraint": {
                    "type": ["string", "null"]
                  },
                  "table": {
                    "type": ["string", "null"]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": ["database_constraint"],
            "properties": {
              "database_constraint": {
                "type": "object",
                "required": ["constraint"],
                "properties": {
                  "constraint": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": ["validation_error_with_cms_anchor_block_id"],
            "properties": {
              "validation_error_with_cms_anchor_block_id": {
                "type": "object",
                "required": ["block_id"],
                "properties": {
                  "block_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          },
          {
            "type": "string",
            "description": "The user is not enrolled on the course the requested exercise belongs to.",
            "enum": ["not_enrolled"]
          },
          {
            "type": "string",
            "description": "A submission named a file that was uploaded but has since been reaped.",
            "enum": ["upload_expired"]
          },
          {
            "type": "string",
            "description": "A submission named a file the host has no upload record of for this exercise and user.",
            "enum": ["unknown_upload"]
          },
          {
            "type": "string",
            "description": "A submission named the same uploaded file more than once.",
            "enum": ["duplicate_upload"]
          },
          {
            "type": "string",
            "description": "A save named a version of the record that is no longer the latest.",
            "enum": ["stale_version"]
          },
          {
            "type": "string",
            "enum": ["chapter_not_open_yet"]
          },
          {
            "type": "string",
            "enum": ["authentication_required_for_exam_exercise"]
          },
          {
            "type": "string",
            "enum": ["response_validation_error"]
          }
        ]
      },
      "NewErrorReport": {
        "type": "object",
        "required": ["service", "message"],
        "properties": {
          "app_version": {
            "type": ["string", "null"]
          },
          "details": {},
          "error_source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ErrorSource"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": ["string", "null"]
          },
          "service": {
            "type": "string"
          },
          "stack_trace": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
